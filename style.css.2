/* ===========================
   ABOUT SECTION
=========================== */

section{
    padding:100px 8%;
}

section h2{
    text-align:center;
    font-size:42px;
    margin-bottom:50px;
    color:var(--primary);
    position:relative;
}

section h2::after{
    content:"";
    width:90px;
    height:4px;
    background:var(--primary);
    display:block;
    margin:15px auto;
    border-radius:20px;
}

.card{
    max-width:900px;
    margin:auto;
    background:var(--card);
    border:1px solid var(--border);
    border-radius:20px;
    padding:40px;
    backdrop-filter:blur(15px);
    box-shadow:var(--shadow);
    transition:.4s;
}

.card:hover{
    transform:translateY(-10px);
}

.card p{
    color:var(--text2);
    line-height:1.9;
    font-size:18px;
}

/* ===========================
   SKILLS
=========================== */

.skills-grid{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(220px,1fr));

gap:25px;

margin-top:40px;

}

.skill-card{

background:var(--card);

padding:30px;

text-align:center;

font-size:20px;

font-weight:600;

border-radius:18px;

border:1px solid var(--border);

transition:.4s;

backdrop-filter:blur(10px);

box-shadow:var(--shadow);

cursor:pointer;

}

.skill-card:hover{

transform:translateY(-12px) scale(1.03);

background:linear-gradient(135deg,#00d4ff22,#0066ff22);

color:var(--primary);

}

/* ===========================
   PROJECTS
=========================== */

.project-grid{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(320px,1fr));

gap:30px;

margin-top:40px;

}

.project{

background:var(--card);

border:1px solid var(--border);

border-radius:20px;

padding:35px;

transition:.4s;

box-shadow:var(--shadow);

backdrop-filter:blur(12px);

position:relative;

overflow:hidden;

}

.project::before{

content:"";

position:absolute;

top:0;

left:-120%;

width:100%;

height:100%;

background:linear-gradient(90deg,transparent,rgba(255,255,255,.15),transparent);

transition:.8s;

}

.project:hover::before{

left:120%;

}

.project:hover{

transform:translateY(-10px);

}

.project h3{

font-size:26px;

margin-bottom:15px;

color:var(--primary);

}

.project p{

color:var(--text2);

line-height:1.8;

}

/* ===========================
   CONTACT
=========================== */

.socials{

display:flex;

justify-content:center;

gap:25px;

flex-wrap:wrap;

margin-top:30px;

}

.socials a{

width:65px;

height:65px;

display:flex;

align-items:center;

justify-content:center;

font-size:28px;

border-radius:50%;

background:var(--card);

border:1px solid var(--border);

color:white;

text-decoration:none;

transition:.4s;

box-shadow:var(--shadow);

}

.socials a:hover{

background:var(--primary);

color:#000;

transform:translateY(-8px) rotate(360deg);

}

footer,
.copyright{

margin-top:50px;

text-align:center;

color:#aaa;

font-size:15px;

padding-bottom:30px;

}

/* ===========================
   SCROLLBAR
=========================== */

::-webkit-scrollbar{

width:10px;

}

::-webkit-scrollbar-track{

background:#08111d;

}

::-webkit-scrollbar-thumb{

background:var(--primary);

border-radius:10px;

}

::-webkit-scrollbar-thumb:hover{

background:#00ffff;

}

/* ===========================
   RESPONSIVE
=========================== */

@media(max-width:900px){

header{

padding:18px 5%;

}

nav{

gap:15px;

}

.hero{

flex-direction:column-reverse;

text-align:center;

padding-top:150px;

}

.hero-text h1{

font-size:42px;

}

.hero-text h2{

font-size:24px;

}

.profile-circle{

width:280px;

height:280px;

}

.buttons{

justify-content:center;

}

}
